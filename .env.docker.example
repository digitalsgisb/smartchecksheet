# Attendance uses real employee data without sample production records or machine commands.
# Set live only with the verified catalog and production MQTT settings below.
APP_MODE=attendance
ADMIN_USERNAME=developer
ADMIN_PASSWORD=
ATTENDANCE_TOKEN=
ATTENDANCE_API_URL=http://host.docker.internal:3800
# One shared server; each signed-in account sees only groups matching its line access.
# ABB2=FC Line 1; ABB3=FC Line 3; ABB7=Mini Forming. ABB4 retired; FC Line 2 unassigned.
# ROLL MAKING is the configurable account label for the whole Roll Making group.
ATTENDANCE_GROUPS='[{"id":"fc1","label":"FC Line 1","lines":["FC"],"assignment":"fc1","accountLines":["ABB2"]},{"id":"fc3","label":"FC Line 3","lines":["FC"],"assignment":"fc3","accountLines":["ABB3"]},{"id":"mf","label":"Mini Forming","lines":["MF"],"accountLines":["ABB7"]},{"id":"roll-making","label":"Roll Making","section":"ROLL MAKING","accountLines":["ROLL MAKING"]}]'
# For HTTPS set COOKIE_SECURE=true. For direct private LAN HTTP use false.
COOKIE_SECURE=true
TRUST_PROXY=false
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
CATALOG_PATH=/app/config/catalog.json
INGEST_TOKEN=
OEE_DASHBOARD_URL=

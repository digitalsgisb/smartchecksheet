# Demo has its own database and never publishes MQTT commands.
APP_MODE=demo
PORT=3700
HOST=127.0.0.1
DATABASE_PATH=./data/production-demo.sqlite
# Set a unique password before exposing the app via a tunnel.
ADMIN_USERNAME=developer
ADMIN_PASSWORD=
# Required behind the HTTPS tunnel; false for localhost development.
COOKIE_SECURE=false
TRUST_PROXY=false
# Existing Node-RED OEE dashboard URL, displayed as an external link.
OEE_DASHBOARD_URL=
# Live mode connects to the ABB2 Pi broker over a private network, not the public tunnel.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Private token for the optional Python durable-event receiver.
INGEST_TOKEN=
# Required in live mode: verified model/manpower JSON; see catalog.example.json.
CATALOG_PATH=

# Smart Attendance backend; server-side only. Never use a VITE_ variable for tokens.
ATTENDANCE_API_URL=http://127.0.0.1:8765
ATTENDANCE_TOKEN=
# Choose this installation's group; see ATTENDANCE-INTEGRATION.md. Empty disables the connection.
ATTENDANCE_GROUPS='[]'

# Real attendance without sample production data or machine commands.
APP_MODE=attendance
PORT=3700
HOST=127.0.0.1
DATABASE_PATH=./data/production-attendance.sqlite
# Set a unique password before exposing the app via a tunnel.
ADMIN_USERNAME=developer
ADMIN_PASSWORD=
# Required behind the HTTPS tunnel; false for localhost development.
COOKIE_SECURE=false
TRUST_PROXY=false
# Existing Node-RED OEE dashboard URL, displayed as an external link.
OEE_DASHBOARD_URL=
# Multi-line live mode: see MULTILINE-PYTHON-SETUP.md.
MACHINE_CONNECTIONS_PATH=
ABB2_MQTT_USERNAME=
ABB2_MQTT_PASSWORD=
ABB2_INGEST_TOKEN=
ABB3_MQTT_USERNAME=
ABB3_MQTT_PASSWORD=
ABB3_INGEST_TOKEN=
ABB7_MQTT_USERNAME=
ABB7_MQTT_PASSWORD=
ABB7_INGEST_TOKEN=
# Legacy single ABB2 connection (used only without MACHINE_CONNECTIONS_PATH).
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Private token for the optional Python durable-event receiver.
INGEST_TOKEN=
# Required in live mode: verified model/manpower JSON; see catalog.example.json.
CATALOG_PATH=

# Smart Attendance backend; server-side only. Never use a VITE_ variable for tokens.
ATTENDANCE_API_URL=http://127.0.0.1:8765
ATTENDANCE_TOKEN=
# Choose this installation's group; see ATTENDANCE-INTEGRATION.md. Empty disables the connection.
ATTENDANCE_GROUPS='[]'

# Sugihara CMMS: dedicated Production requester; see CMMS-INTEGRATION.md.
# Origin only, e.g. http://127.0.0.1:3300 (no /api).
CMMS_API_URL=
CMMS_USERNAME=
CMMS_PASSWORD=
